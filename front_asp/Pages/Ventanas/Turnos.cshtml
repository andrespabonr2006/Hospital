@page
@model TurnosModel
@{
    ViewData["Title"] = "Turnos";
}
<form method="post"
      enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Turnos</h1>
        <div>
            <input type="submit"
                   value="Consultar"
                   class="btn btn-secondary"
                   asp-page-handler="BtConsultar" />
            <input type="submit"
                   value="Nuevo"
                   class="btn btn-secondary"
                   asp-page-handler="BtNuevo" />
            <input type="submit"
                   value="Guardar"
                   class="btn btn-secondary"
                   asp-page-handler="BtGuardar" />
            <input id="flJornada"
                   placeholder="Jornada"
                   asp-for="@Model.Filtro!.Jornada" />
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
            ;
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                   asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Turno</h3>

                <label>
                    Jornada
                </label>
                <input id="nmJornada"
                       asp-for="@Model.Actual!.Jornada" />
                <br />

                <label>
                    HoraInicio
                </label>
                <input id="nmHoraInicio"
                       asp-for="@Model.Actual!.HoraInicio" />
                <br />

                <label>
                    HoraFinal
                </label>
                <input id="nmHoraFinal"
                       asp-for="@Model.Actual!.HoraFinal" />
                <br />

                <label>
                    Medico
                </label>
                <select id="nmMedico"
                        asp-for="@Model.Actual!.Medico"
                        asp-items="@(new SelectList(Model.Medicos, "Id", "Nombre"))">
                </select>
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>
                        Mensaje
                    </h3>

                    <h4>
                        ¿Quiere borrar el registro con información
                        @Model.Actual!.Jornada?
                    </h4>
                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtConsultar" />
                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Id</th>
                        <th>Jornada</th>
                        <th>HoraInicio</th>
                        <th>HoraFinal</th>
                        <th>Medico</th>
                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Id</td>
                                <td>@elemento.Jornada</td>
                                <td>@elemento.HoraInicio</td>
                                <td>@elemento.HoraFinal</td>
                                <td>@elemento._Medico!.Nombre</td>
                                <td>
                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.Id" />
                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>
