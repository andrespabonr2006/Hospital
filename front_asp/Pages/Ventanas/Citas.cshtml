@page
@model CitasModel
@{
    ViewData["Title"] = "Citas";
}
<form method="post"
      enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Citas</h1>
        <div>
            <input type="submit"
                   value="Consultar"
                   class="btn btn-secondary"
                   asp-page-handler="BtConsultar" />
            <input type="submit"
                   value="Nuevo"
                   class="btn btn-secondary"
                   asp-page-handler="BtNuevo" />
            <input type="submit"
                   value="Guardar"
                   class="btn btn-secondary"
                   asp-page-handler="BtGuardar" />
            <input id="flEstado"
                   placeholder="Estado"
                   asp-for="@Model.Filtro!.Estado" />
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
            ;
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                   asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Cita</h3>

                <label>
                    Fecha
                </label>
                <input id="nmFecha"
                       asp-for="@Model.Actual!.Fecha" />
                <br />

                <label>
                    Estado
                </label>
                <input id="nmEstado"
                       asp-for="@Model.Actual!.Estado" />
                <br />

                <label>
                    Solicitud
                </label>
                <select id="nmSolicitud"
                        asp-for="@Model.Actual!.Solicitud"
                        asp-items="@(new SelectList(Model.Solicitudes, "Id", "Motivo"))">
                </select>
                <br />

                <label>
                    Paciente
                </label>
                <select id="nmPaciente"
                        asp-for="@Model.Actual!.Paciente"
                        asp-items="@(new SelectList(Model.Pacientes, "Id", "Nombre"))">
                </select>
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>
                        Mensaje
                    </h3>

                    <h4>
                        ¿Quiere borrar el registro con información
                        @Model.Actual!.Estado?
                    </h4>
                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtConsultar" />
                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Id</th>
                        <th>Fecha</th>
                        <th>Estado</th>
                        <th>Solicitud</th>
                        <th>Paciente</th>
                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Id</td>
                                <td>@elemento.Fecha</td>
                                <td>@elemento.Estado</td>
                                <td>@elemento._Solicitud!.Motivo</td>
                                <td>@elemento._Paciente!.Nombre</td>
                                <td>
                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.Id" />
                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>
