@page
@model ProcedimientosModel
@{
    ViewData["Title"] = "Procedimientos";
}
<form method="post"
      enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Procedimientos</h1>
        <div>
            <input type="submit"
                   value="Consultar"
                   class="btn btn-secondary"
                   asp-page-handler="BtConsultar" />
            <input type="submit"
                   value="Nuevo"
                   class="btn btn-secondary"
                   asp-page-handler="BtNuevo" />
            <input type="submit"
                   value="Guardar"
                   class="btn btn-secondary"
                   asp-page-handler="BtGuardar" />
            <input id="flProceso"
                   placeholder="Proceso"
                   asp-for="@Model.Filtro!.Proceso" />
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
            ;
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                   asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Procedimiento</h3>

                <label>
                    Proceso
                </label>
                <input id="nmProceso"
                       asp-for="@Model.Actual!.Proceso" />
                <br />

                <label>
                    Duracion
                </label>
                <input id="nmDuracion"
                       asp-for="@Model.Actual!.Duracion" />
                <br />

                <label>
                    Costo
                </label>
                <input id="nmCosto"
                       asp-for="@Model.Actual!.Costo" />
                <br />

                <label>
                    Examen
                </label>
                <select id="nmExamen"
                        asp-for="@Model.Actual!.Examen"
                        asp-items="@(new SelectList(Model.Examenes, "Id", "Tipo"))">
                </select>
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>
                        Mensaje
                    </h3>

                    <h4>
                        ¿Quiere borrar el registro con información
                        @Model.Actual!.Proceso,
                        @Model.Actual!.Duracion?
                    </h4>
                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtConsultar" />
                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Id</th>
                        <th>Proceso</th>
                        <th>Duracion</th>
                        <th>Costo</th>
                        <th>Examen</th>
                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Id</td>
                                <td>@elemento.Proceso</td>
                                <td>@elemento.Duracion</td>
                                <td>@elemento.Costo</td>
                                <td>@elemento._Examen!.Tipo</td>
                                <td>
                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.Id" />
                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>
