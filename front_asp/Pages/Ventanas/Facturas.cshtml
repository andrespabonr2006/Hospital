@page
@model FacturasModel
@{
    ViewData["Title"] = "Facturas";
}
<form method="post"
      enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Facturas</h1>
        <div>
            <input type="submit"
                   value="Consultar"
                   class="btn btn-secondary"
                   asp-page-handler="BtConsultar" />
            <input type="submit"
                   value="Nuevo"
                   class="btn btn-secondary"
                   asp-page-handler="BtNuevo" />
            <input type="submit"
                   value="Guardar"
                   class="btn btn-secondary"
                   asp-page-handler="BtGuardar" />
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
            ;
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                   asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Factura</h3>

                <label>
                    FechaEmision
                </label>
                <input id="nmFechaEmision"
                       asp-for="@Model.Actual!.FechaEmision" />
                <br />

                <label>
                    Subtotal
                </label>
                <input id="nmSubtotal"
                       asp-for="@Model.Actual!.Subtotal" />
                <br />

                <label>
                    Impuesto
                </label>
                <input id="nmImpuesto"
                       asp-for="@Model.Actual!.Impuesto" />
                <br />

                <label>
                    Medicamento
                </label>
                <select id="nmMedicamento"
                        asp-for="@Model.Actual!.Medicamento"
                        asp-items="@(new SelectList(Model.Medicamentos, "Id", "NombreComercial"))">
                </select>
                <br />

                <label>
                    Procedimiento
                </label>
                <select id="nmProcedimiento"
                        asp-for="@Model.Actual!.Procedimiento"
                        asp-items="@(new SelectList(Model.Procedimientos, "Id", "Proceso"))">
                </select>
                <br />

                <label>
                    Administrativo
                </label>
                <select id="nmAdministrativo"
                        asp-for="@Model.Actual!.Administrativo"
                        asp-items="@(new SelectList(Model.Administrativos, "Id", "Nombre"))">
                </select>
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>
                        Mensaje
                    </h3>

                    <h4>
                        ¿Quiere borrar el registro con información
                        @Model.Actual!.FechaEmision,
                        @Model.Actual!.Subtotal?
                    </h4>
                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtConsultar" />
                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Id</th>
                        <th>FechaEmision</th>
                        <th>Subtotal</th>
                        <th>Impuesto</th>
                        <th>Medicamento</th>
                        <th>Procedimiento</th>
                        <th>Administrativo</th>
                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Id</td>
                                <td>@elemento.FechaEmision</td>
                                <td>@elemento.Subtotal</td>
                                <td>@elemento.Impuesto</td>
                                <td>@elemento._Medicamento!.NombreComercial</td>
                                <td>@elemento._Procedimiento!.Proceso</td>
                                <td>@elemento._Administrativo!.Nombre</td>
                                <td>
                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.Id" />
                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>
