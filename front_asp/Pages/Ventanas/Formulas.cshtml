@page
@model FormulasModel
@{
    ViewData["Title"] = "Formulas";
}
<form method="post"
      enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Formulas</h1>
        <div>
            <input type="submit"
                   value="Consultar"
                   class="btn btn-secondary"
                   asp-page-handler="BtConsultar" />
            <input type="submit"
                   value="Nuevo"
                   class="btn btn-secondary"
                   asp-page-handler="BtNuevo" />
            <input type="submit"
                   value="Guardar"
                   class="btn btn-secondary"
                   asp-page-handler="BtGuardar" />
            <input id="flIndicacion"
                   placeholder="Indicacion"
                   asp-for="@Model.Filtro!.Indicacion" />
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
            ;
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                   asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Fórmula</h3>

                <label>
                    Fecha
                </label>
                <input id="nmFecha"
                       asp-for="@Model.Actual!.Fecha" />
                <br />

                <label>
                    Indicacion
                </label>
                <input id="nmIndicacion"
                       asp-for="@Model.Actual!.Indicacion" />
                <br />

                <label>
                    Vigencia
                </label>
                <input id="nmVigencia"
                       asp-for="@Model.Actual!.Vigencia" />
                <br />

                <label>
                    Consulta
                </label>
                <select id="nmConsulta"
                        asp-for="@Model.Actual!.Consulta"
                        asp-items="@(new SelectList(Model.Consultas, "Id", "Observacion"))">
                </select>
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>
                        Mensaje
                    </h3>

                    <h4>
                        ¿Quiere borrar el registro con información
                        @Model.Actual!.Indicacion,
                        @Model.Actual!.Vigencia?
                    </h4>
                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtConsultar" />
                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Id</th>
                        <th>Fecha</th>
                        <th>Indicacion</th>
                        <th>Vigencia</th>
                        <th>Consulta</th>
                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Id</td>
                                <td>@elemento.Fecha</td>
                                <td>@elemento.Indicacion</td>
                                <td>@elemento.Vigencia</td>
                                <td>@elemento._Consulta!.Observacion</td>
                                <td>
                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.Id" />
                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>
