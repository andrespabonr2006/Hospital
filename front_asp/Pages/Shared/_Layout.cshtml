@using front_asp.Nucleo
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hospital</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/front_asp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark barra mb-4">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">+ Hospital</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white"
                               asp-area=""
                               asp-page="/Index">Home</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white" href="#" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">Ventanas</a>
                            <ul class="dropdown-menu">
                                @if (Seguridad.TienePermiso(Context, "Hospitales"))
                                {
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Hospitales">Hospitales</a></li>
                                }
                                @if (Seguridad.TienePermiso(Context, "Pacientes"))
                                {
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Pacientes">Pacientes</a></li>
                                }
                                @if (Seguridad.TienePermiso(Context, "Sectores"))
                                {
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Sectores">Sectores</a></li>
                                }
                                @if (Seguridad.TienePermiso(Context, "Medicos"))
                                {
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Medicos">Medicos</a></li>
                                }
                                @if (Seguridad.TienePermiso(Context, "Turnos"))
                                {
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Turnos">Turnos</a></li>
                                }
                                @if (Seguridad.TienePermiso(Context, "Consultorios"))
                                {
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Consultorios">Consultorios</a></li>
                                }
                                @if (Seguridad.TienePermiso(Context, "Habitaciones"))
                                {
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Habitaciones">Habitaciones</a></li>
                                }
                                @if (Seguridad.TienePermiso(Context, "Historiales"))
                                {
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Historiales">Historiales</a></li>
                                }
                                @if (Seguridad.TienePermiso(Context, "Solicitudes"))
                                {
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Solicitudes">Solicitudes</a></li>
                                }
                                @if (Seguridad.TienePermiso(Context, "Seguros"))
                                {
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Seguros">Seguros</a></li>
                                }
                                @if (Seguridad.TienePermiso(Context, "Citas"))
                                {
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Citas">Citas</a></li>
                                }
                                @if (Seguridad.TienePermiso(Context, "Consultas"))
                                {
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Consultas">Consultas</a></li>
                                }
                                @if (Seguridad.TienePermiso(Context, "Enfermedades"))
                                {
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Enfermedades">Enfermedades</a></li>
                                }
                                @if (Seguridad.TienePermiso(Context, "Formulas"))
                                {
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Formulas">Formulas</a></li>
                                }
                                @if (Seguridad.TienePermiso(Context, "Examenes"))
                                {
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Examenes">Examenes</a></li>
                                }
                                @if (Seguridad.TienePermiso(Context, "Procedimientos"))
                                {
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Procedimientos">Procedimientos</a></li>
                                }
                                @if (Seguridad.TienePermiso(Context, "Medicamentos"))
                                {
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Medicamentos">Medicamentos</a></li>
                                }
                                @if (Seguridad.TienePermiso(Context, "Administrativos"))
                                {
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Administrativos">Administrativos</a></li>
                                }
                                @if (Seguridad.TienePermiso(Context, "Facturas"))
                                {
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Facturas">Facturas</a></li>
                                }
                                @if (Seguridad.TienePermiso(Context, "Pagos"))
                                {
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Pagos">Pagos</a></li>
                                }
                            </ul>
                        </li>
                        @if (Seguridad.TienePermiso(Context, "Reportes"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-page="/Reportes">Reportes</a>
                            </li>
                        }
                        @if (Seguridad.EsAdministrador(Context))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white" href="#" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">Seguridad</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Usuarios">Usuarios</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Roles">Roles</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Permisos">Permisos</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Auditorias">Auditorías</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    @if (Seguridad.EstaLogueado(Context))
                    {
                        <button type="button" class="btn btn-light btn-sm me-2" onclick="window.print()">Imprimir</button>
                        <span class="navbar-text text-white usuario-nav">
                            @Context.Session.GetString("Usuario") (@Context.Session.GetString("Rol"))
                        </span>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Sistema Hospital
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
