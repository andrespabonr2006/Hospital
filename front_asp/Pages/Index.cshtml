@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}
@if (!Model.EstaLogueado)
{
    <div class="login-caja">
        <h2>Iniciar sesión</h2>
        <p class="login-sub">Sistema del Hospital</p>

        <form method="POST">
            <label>Usuario:</label>
            <input asp-for="@Model.Email"
                   class="form-control" />

            <label>Contraseña:</label>
            <input type="password"
                   asp-for="@Model.Contrasena"
                   class="form-control" />

            <div class="login-botones">
                <input type="submit"
                       value="Limpiar"
                       asp-page-handler="BtClean"
                       class="btn btn-secondary" />
                <input type="submit"
                       value="Entrar"
                       asp-page-handler="BtEnter"
                       class="btn btn-primary" />
            </div>
        </form>
    </div>
}
else
{
    <div class="bienvenida">
        <h1>Bienvenido</h1>
        <p>Elige una ventana en el menú <b>Ventanas</b> de arriba.</p>

        <form method="POST">
            <input type="submit"
                   value="Cerrar sesión"
                   asp-page-handler="BtClose"
                   class="btn btn-secondary" />
        </form>
    </div>
}
